    - target: {fileID: 3185858870652657804, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5584607345144154889, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: m_Name
      value: Note
      objectReference: {fileID: 0}
    - target: {fileID: 8894391949465822486, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: noteText
      value: "My dearest Christos,\r\n\r\nI prayed for the child we lost, but Heaven
        stayed silent. I told myself it was mercy \u2014 that I spared us both another
        mouth we could not feed. But each night, I hear him crying where there is
        no sound.\r\n\r\nYou said faith could forgive any sin. I believed you. I
        prayed until my hands trembled, yet I still feel the blood on them.\r\n\r\nI
        cannot bear to ask you to forgive me too. So I\u2019ll lay my guilt before
        Him, and let the Lord decide if I am mother or murderer.\r\n\r\nIf you find
        me, don\u2019t pray for me. Just remember that I loved you \u2014 and the
        child I never met.\r\n\r\n\u2014 Maria"
      objectReference: {fileID: 0}
    - target: {fileID: 8894391949465822486, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: triggersTask
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8894391949465822486, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: taskIndexToTrigger
      value: 30
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
