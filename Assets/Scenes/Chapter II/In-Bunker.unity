      value: -97.741
      objectReference: {fileID: 0}
    - target: {fileID: 5584607345144154889, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: m_Name
      value: Note
      objectReference: {fileID: 0}
    - target: {fileID: 8894391949465822486, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: noteText
      value: "I found her beneath the altar, hands folded, eyes closed as if in prayer.
        The rosary was wrapped so tightly around her wrists it drew blood.\r\n\r\nThere
        was no fever left in her, only peace\u2026 or something that looked like
        it.\r\n\r\nShe confessed before she went, said she could no longer carry
        the weight of what she had taken from God. I could not speak. I only listened
        as she begged for forgiveness no one could give.\r\n\r\n\u201CDeliver me,
        O Lord, from the life I denied.\u201D\r\n\r\n\u2014 Father Nong"
      objectReference: {fileID: 0}
    - target: {fileID: 8894391949465822486, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: triggersTask
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8894391949465822486, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: taskIndexToTrigger
      value: 26
      objectReference: {fileID: 0}
