    - target: {fileID: 5584607345144154889, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: m_Name
      value: Note
      objectReference: {fileID: 0}
    - target: {fileID: 8894391949465822486, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: noteText
      value: "Lord, forgive me.\n\nI have prayed until my knees bled, but the silence
        will not answer.\n\nHe deserves a father \u2014 someone who can teach him
        to flourish, to love, to live without shame. But I have taken that chance
        from him.\n\nI can still hear the Father\u2019s voice reminding me of the
        Psalms... I, IV, VI, IX... but even those verses feel hollow now.\n\nIf this
        is the price of mercy, then let me bear it alone.\n\nPlease, let no one else
        carry my sin."
      objectReference: {fileID: 0}
    - target: {fileID: 8894391949465822486, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: triggersTask
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8894391949465822486, guid: 0ff8d03a4956b7e49be4fff4ffd3ad12, type: 3}
      propertyPath: taskIndexToTrigger
      value: 20
      objectReference: {fileID: 0}
